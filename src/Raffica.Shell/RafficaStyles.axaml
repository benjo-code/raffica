<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Raffica.Shell.Controls"
        x:Class="Raffica.Shell.RafficaStyles">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Metrics.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Fonts.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Focus.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/Button.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/ToggleButton.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/CheckBox.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/RadioButton.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/SegmentedControl.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/TextBox.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/ComboBox.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/Menu.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/ContextMenu.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Controls/ToolTip.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <FluentTheme />
  <StyleInclude Source="avares://Raffica.Shell/Styles/Typography.axaml" />
</Styles>
