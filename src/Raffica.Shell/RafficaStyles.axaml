<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Raffica.Shell.RafficaStyles">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://Raffica.Shell/Styles/Metrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <FluentTheme />
</Styles>
