<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Icon geometries from Lucide, tag 1.63.0 (ISC, see third-party/lucide), 24 x 24 units, drawn by Controls/StrokeIcon
    with a 1.5 px stroke at 16 or 20 px. Shapes other than paths were converted: circle to two arcs, line to M and L.
    A path that starts with a relative m starts with the absolute M, so that the paths of one icon can be joined.
    Align left, center and right are text-align-start, text-align-center and text-align-end in Lucide.
  -->
  <StreamGeometry x:Key="Raffica.Icon.Check">M20 6 9 17l-5-5</StreamGeometry>
  <StreamGeometry x:Key="Raffica.Icon.ChevronDown">M6 9l 6 6 6-6</StreamGeometry>
