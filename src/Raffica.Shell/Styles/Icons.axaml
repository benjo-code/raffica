  <StreamGeometry x:Key="Raffica.Icon.Info">M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0 M12 16v-4 M12 8h.01</StreamGeometry>
  <StreamGeometry x:Key="Raffica.Icon.TriangleAlert">M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3 M12 9v4 M12 17h.01</StreamGeometry>
