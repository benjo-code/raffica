<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Raffica.Shell.Controls">
  <!--
    Segmented control, row "Segmented choice" of the state table (appendix A section 5 of
    Docs/superpowers/specs/2026-11-03-design-system-shell-design.md): 26 px high segments in a row, page fill with the
    1 px control edge, hover state.hover, selected = selection.tint with a 3 px ink edge at the bottom and weight 600,
    3 px radius on the outer ends only. The edges overlap: every segment draws its left edge, the last one also its right.
    The keyboard ring is the shared adorner. Arrow keys move the selection (ListBox with single selection).
  -->
  <ControlTheme x:Key="Raffica.Theme.SegmentedItem" TargetType="controls:SegmentedControlItem">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Surface.Page}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Raffica.Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Height" Value="{DynamicResource Raffica.Size.Button}" />
    <Setter Property="FontFamily" Value="{DynamicResource Raffica.Font.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="400" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <Border x:Name="InkEdge"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Height="3"
                  Margin="1,0,1,1"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource Raffica.Brush.Ink}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:nth-child(1)">
      <Setter Property="CornerRadius" Value="3,0,0,3" />
    </Style>
    <Style Selector="^:nth-last-child(1)">
      <Setter Property="CornerRadius" Value="0,3,3,0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^:nth-child(1):nth-last-child(1)">
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Raffica.Brush.State.Hover}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="FontWeight" Value="600" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    </Style>
    <Style Selector="^:selected /template/ Border#InkEdge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Disabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:SegmentedControl}" TargetType="controls:SegmentedControl">
    <Setter Property="ItemContainerTheme" Value="{StaticResource Raffica.Theme.SegmentedItem}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
