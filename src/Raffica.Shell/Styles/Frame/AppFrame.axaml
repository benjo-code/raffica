<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:frame="clr-namespace:Raffica.Shell.Frame">
  <!--
    The app frame (section 6 of Docs/superpowers/specs/2026-11-03-design-system-shell-design.md): rows of 36 (title bar, surface.page,
    1 px rule drawn over its last pixel row), 32 (command tab row), 82 (ribbon band, 40 compact), the document row, the optional notification and 30
    (status bar, which draws its own 1 px rule above). Panels left and right of the document row are surface.band with a 1 px rule on the inner edge.
    All edges are square, nothing has a shadow. The rules of the title bar and the band overlay the last pixel row of their fixed height. The fixed rows are wrappers with a height; the grid rows are Auto, so a row whose
    slot is empty collapses by hiding its wrapper.
  -->
  <ControlTheme x:Key="{x:Type frame:AppFrame}" TargetType="frame:AppFrame">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Surface.Desk}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              ColumnDefinitions="Auto,*,Auto">
          <Border x:Name="PART_TitleBarRow"
                  Grid.Row="0" Grid.ColumnSpan="3"
                  Height="{DynamicResource Raffica.Size.TitleBar}"
                  Background="{DynamicResource Raffica.Brush.Surface.Page}">
            <Panel>
              <ContentPresenter Content="{TemplateBinding TitleBar}" />
              <Border VerticalAlignment="Bottom" IsHitTestVisible="False" Height="{DynamicResource Raffica.Rule.Width}" Background="{DynamicResource Raffica.Brush.Rule}" />
            </Panel>
          </Border>
          <Border x:Name="PART_TabRowRow"
                  Grid.Row="1" Grid.ColumnSpan="3"
                  Height="{DynamicResource Raffica.Size.TabRow}"
                  Background="{DynamicResource Raffica.Brush.Surface.Page}">
            <ContentPresenter Content="{TemplateBinding TabRow}" />
          </Border>
          <Border x:Name="PART_BandRow"
                  Grid.Row="2" Grid.ColumnSpan="3"
                  Height="{DynamicResource Raffica.Size.Ribbon}"
                  Background="{DynamicResource Raffica.Brush.Surface.Band}">
            <Panel>
              <ContentPresenter Content="{TemplateBinding Band}" />
              <Border VerticalAlignment="Bottom" IsHitTestVisible="False" Height="{DynamicResource Raffica.Rule.Width}" Background="{DynamicResource Raffica.Brush.Rule}" />
            </Panel>
          </Border>
          <Border x:Name="PART_LeftPaneRow"
                  Grid.Row="3" Grid.Column="0"
                  Background="{DynamicResource Raffica.Brush.Surface.Band}"
                  BorderBrush="{DynamicResource Raffica.Brush.Rule}"
                  BorderThickness="0,0,1,0"
                  IsVisible="{TemplateBinding LeftPane, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentPresenter Content="{TemplateBinding LeftPane}" />
          </Border>
          <ContentPresenter x:Name="PART_Document"
                            Grid.Row="3" Grid.Column="1"
                            Content="{TemplateBinding Document}" />
          <Border x:Name="PART_RightPaneRow"
                  Grid.Row="3" Grid.Column="2"
                  Background="{DynamicResource Raffica.Brush.Surface.Band}"
                  BorderBrush="{DynamicResource Raffica.Brush.Rule}"
                  BorderThickness="1,0,0,0"
                  IsVisible="{TemplateBinding RightPane, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentPresenter Content="{TemplateBinding RightPane}" />
          </Border>
          <ContentPresenter x:Name="PART_NotificationRow"
                            Grid.Row="4" Grid.ColumnSpan="3"
                            Content="{TemplateBinding Notification}"
                            IsVisible="{TemplateBinding Notification, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border x:Name="PART_StatusBarRow"
                  Grid.Row="5" Grid.ColumnSpan="3"
                  Height="{DynamicResource Raffica.Size.StatusBar}"
                  Background="{DynamicResource Raffica.Brush.Surface.Band}"
                  IsVisible="{TemplateBinding StatusBar, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentPresenter Content="{TemplateBinding StatusBar}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:compact /template/ Border#PART_BandRow">
      <Setter Property="Height" Value="{DynamicResource Raffica.Size.RibbonCompact}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
