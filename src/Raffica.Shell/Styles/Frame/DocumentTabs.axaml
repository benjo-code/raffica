<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:frame="clr-namespace:Raffica.Shell.Frame">
  <!--
    The document tabs of the title bar (section 6 of the design spec): square, 28 px high, 96 to 240 px wide, 13 px text in
    text.secondary. A tab under the pointer takes the hover fill; the selected tab is surface.band with a 3 px ink edge on top and a
    1 px rule on both sides, its text in text.primary. The close button is 24 x 24 and the "+" button 28 x 28, both with the 3 px
    radius of the button theme. No shadow, no uppercase.
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type frame:DocumentTabs}" TargetType="frame:DocumentTabs">
      <Setter Property="Height" Value="{DynamicResource Raffica.Size.DocumentTab}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Host" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Border.document-tab">
    <Setter Property="Height" Value="{DynamicResource Raffica.Size.DocumentTab}" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="MaxWidth" Value="{DynamicResource Raffica.Size.DocumentTabMax}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="TextElement.FontSize" Value="13" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.document-tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.State.Hover}" />
  </Style>
  <Style Selector="Border.document-tab:selected">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Surface.Band}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Raffica.Brush.Rule}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="Border.document-tab-edge">
    <Setter Property="Height" Value="3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.document-tab:selected Border.document-tab-edge">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Ink}" />
  </Style>

  <Style Selector="Ellipse.document-tab-dirty">
    <Setter Property="Fill" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>

  <Style Selector="Button.document-tab-close">
    <Setter Property="Width" Value="{DynamicResource Raffica.Size.HitTargetMin}" />
    <Setter Property="MinWidth" Value="{DynamicResource Raffica.Size.HitTargetMin}" />
    <Setter Property="Height" Value="{DynamicResource Raffica.Size.HitTargetMin}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.document-tab-new">
    <Setter Property="Width" Value="{DynamicResource Raffica.Size.DocumentTab}" />
    <Setter Property="MinWidth" Value="{DynamicResource Raffica.Size.DocumentTab}" />
    <Setter Property="Height" Value="{DynamicResource Raffica.Size.DocumentTab}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
</Styles>
