<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Raffica.Gallery.Sections.DialogsSection">
  <StackPanel Spacing="16">
    <TextBlock x:Name="Title" Classes="heading-dialog" />
    <StackPanel x:Name="Bars" Spacing="8" MaxWidth="1100" HorizontalAlignment="Left" />
    <Button x:Name="OpenButton" Classes="boxed" />
  </StackPanel>
</UserControl>
