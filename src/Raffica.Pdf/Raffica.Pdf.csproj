<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RafficaPdf</AssemblyName>
    <RootNamespace>Raffica.Pdf</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- German number and date formats are needed by the texts of the app. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- Platform code (later milestones) calls into the operating system. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <ProjectReference Include="..\Raffica.Core\Raffica.Core.csproj" />
    <ProjectReference Include="..\Raffica.Shell\Raffica.Shell.csproj" />
    <TrimmerRootAssembly Include="Raffica.Shell" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Raffica.Pdf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both languages are embedded in this assembly (no satellite assemblies, which need runtime assembly loading under Native AOT). -->
    <EmbeddedResource Update="Resources\Strings.en.resx" WithCulture="false" LogicalName="Raffica.Pdf.Strings.en.resources" />
    <EmbeddedResource Update="Resources\Strings.de.resx" WithCulture="false" LogicalName="Raffica.Pdf.Strings.de.resources" />
  </ItemGroup>
  <ItemGroup>
    <!-- Geist Regular (Core embeds the same file for the text box appearance): the font of the text box editing field, so the field shows what the page will. -->
    <AvaloniaResource Include="..\Raffica.Core\Assets\Fonts\Geist-Regular.ttf" Link="Assets\Fonts\Geist-Regular.ttf" />
  </ItemGroup>
</Project>
