<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The lists of the navigation pane (thumbnails and outline): the shell tokens only. Fluent stays underneath for the list itself; the
       items get no accent fill, a hover and a selection tint from the tokens, and the keyboard ring of the shell inside the item. -->
  <Style Selector="ListBox.nav-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem">
    <Setter Property="Padding" Value="4,6,6,6" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource Raffica.Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border AdornerLayer.IsClipEnabled="False"
                BorderThickness="2"
                CornerRadius="{DynamicResource Raffica.Radius.Control}"
                BorderBrush="{DynamicResource Raffica.Brush.Focus.Ring}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <!-- The selection is not carried by the tint alone (1.2 : 1 on the pane): the selected item has a 2 px edge bar on the left in text.primary,
       like the edge of a mark in the marks list. The 2 px are always there (transparent when not selected) so the content does not move. -->
  <Style Selector="ListBox.nav-list > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.State.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.nav-list > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.thumbnail-number">
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>
  <Style Selector="ListBoxItem.current TextBlock.thumbnail-number">
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
    <Setter Property="FontWeight" Value="600" />
  </Style>
  <Style Selector="TextBlock.outline-title.no-page">
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.nav-hint">
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>
  <!-- The marks list (right pane): rows of several lines. The selected row shows an edge bar as well as the tint, so the selection never
       rests on colour alone; the swatch of a mark's colour has a border of the control token so that a pale colour still shows. -->
  <Style Selector="ListBox.marks-list > ListBoxItem">
    <Setter Property="Padding" Value="6,6,6,6" />
  </Style>
  <Style Selector="Border.mark-edge">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="1" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.mark-edge">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="Border.mark-swatch">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Raffica.Brush.Border.Control}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.mark-comment">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Raffica.Brush.Rule}" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>
</Styles>
