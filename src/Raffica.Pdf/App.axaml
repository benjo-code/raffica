<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Raffica.Shell"
             x:Class="Raffica.Pdf.App">
  <Application.Styles>
    <shell:RafficaStyles />
    <StyleInclude Source="avares://RafficaPdf/Styles/PageView.axaml" />
    <StyleInclude Source="avares://RafficaPdf/Styles/Panes.axaml" />
    <StyleInclude Source="avares://RafficaPdf/Styles/SearchBar.axaml" />
    <StyleInclude Source="avares://RafficaPdf/Styles/StyleStrip.axaml" />
  </Application.Styles>
</Application>
