<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Raffica.Write.WriteWindow"
        Width="1280"
        Height="860"
        MinWidth="1024"
        MinHeight="480"
        Background="{DynamicResource Raffica.Brush.Surface.Page}"
        Foreground="{DynamicResource Raffica.Brush.Text.Primary}"
        FontFamily="{DynamicResource Raffica.Font.Ui}"
        FontSize="14">
  <Window.Styles>
    <!-- The app mark in the title bar: a small ink tile with the initial (the ink is the accent of Write). -->
    <Style Selector="Border.app-mark">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="{DynamicResource Raffica.Radius.Control}" />
      <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Ink}" />
    </Style>
    <Style Selector="Border.app-mark > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.OnInk}" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The area of a document before its pages are drawn: the desk, and the file name in secondary text. -->
    <Style Selector="Border.document-area">
      <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Surface.Desk}" />
    </Style>
    <Style Selector="Border.document-area > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
</Window>
