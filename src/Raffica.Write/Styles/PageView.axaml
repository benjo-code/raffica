<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="using:Raffica.Write.Viewing">
  <!-- The page view: the desk behind the pages from the shell tokens. The paper is white in every theme (the colours of a document assume it) and its
       shadow is the shell's page shadow; the view draws both itself. -->
  <Style Selector="view|PageView">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Surface.Desk}" />
    <!-- The shell focus ring (2 px, app ink, keyboard focus only), drawn inside the edge: the view fills its pane, so a ring outside the control would be cut off. -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border AdornerLayer.IsClipEnabled="False"
                BorderThickness="2"
                BorderBrush="{DynamicResource Raffica.Brush.Focus.Ring}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
</Styles>
