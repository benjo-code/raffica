<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The list of the outline pane: the shell tokens only. Fluent stays underneath for the list itself; the items get no accent fill, a hover and a selection tint from the
       tokens and the keyboard ring of the shell inside the item. The selected item also has a 2 px edge bar in text.primary (the always-present transparent edge keeps the
       content from moving), so the selection never rests on colour alone. -->
  <Style Selector="ListBox.outline-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.outline-list > ListBoxItem">
    <Setter Property="Padding" Value="4,5,6,5" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Raffica.Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border AdornerLayer.IsClipEnabled="False"
                BorderThickness="2"
                CornerRadius="{DynamicResource Raffica.Radius.Control}"
                BorderBrush="{DynamicResource Raffica.Brush.Focus.Ring}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.outline-list > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.outline-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.State.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.outline-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.outline-list > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="ListBox.outline-list > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Raffica.Brush.Selection.Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.outline-title.level1">
    <Setter Property="FontWeight" Value="600" />
  </Style>
  <Style Selector="TextBlock.outline-title.level3">
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.outline-hint">
    <Setter Property="Foreground" Value="{DynamicResource Raffica.Brush.Text.Secondary}" />
  </Style>
</Styles>
